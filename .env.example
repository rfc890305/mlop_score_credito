# Copie para .env e ajuste. NUNCA versione o arquivo .env real.
# Chaves dos parceiros (separadas por vírgula). Gere com: python -c "import secrets;print(secrets.token_urlsafe(32))"
QF_API_KEYS=troque-pela-chave-do-parceiro-1,troque-pela-chave-do-parceiro-2
# Chaves administrativas (permitem recarregar o modelo)
QF_ADMIN_KEYS=troque-pela-chave-admin
# Throttling por chave (sintaxe "N/second|minute|hour|day")
QF_RATE_LIMIT=30/minute
# Armazenamento dos contadores do throttling. Com mais de uma réplica use Redis: redis://host:6379
QF_RATE_LIMIT_STORAGE=memory://
# Opcional: servidor MLflow remoto (padrão: sqlite:///mlflow.db local)
# MLFLOW_TRACKING_URI=http://mlflow.interno:5000
QF_LOG_LEVEL=INFO
